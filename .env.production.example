# ==============================================================================
# BLR.LIFE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file is an example template for production deployments.
# NEVER commit the actual .env.production file containing real secrets to Git.
# Ensure file permissions are restricted on the server (e.g., chmod 600).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Configuration (Used by Caddy)
# ------------------------------------------------------------------------------
FRONTEND_HOST=blr.life
API_HOST=api.blr.life

# ------------------------------------------------------------------------------
# 2. FastAPI Core Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
# The URL where the frontend can reach the API from the browser
NEXT_PUBLIC_API_URL=https://api.blr.life

# Security & CORS
CORS_ORIGINS=["https://blr.life", "https://www.blr.life"]
TRUSTED_HOSTS=["api.blr.life"]
# The internal Docker network subnet for Caddy (used by ProxyHeadersMiddleware)
FORWARDED_ALLOW_IPS=172.28.0.0/16

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 3. Database Credentials
# ------------------------------------------------------------------------------
# ! IMPORTANT: YOU MUST CHANGE THESE FOR PRODUCTION !
POSTGRES_USER=blrlife_prod
POSTGRES_PASSWORD=generate_a_very_secure_password_here
POSTGRES_DB=blrlife_prod

# Used by SQLAlchemy inside the API container.
# Do not change the hostname 'db' or port '5432' as they map to the docker network.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
