# ==============================================================================
# BLR.LIFE V1 ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file defines the contract for all environment variables used by the app.
# 
# Usage:
# - Local Docker development: Copy this to `.env` and use the local defaults.
# - Production (Render/Neon/Vercel): Set these variables in their respective dashboards.
#
# DO NOT COMMIT REAL PASSWORDS OR PRODUCTION SECRETS.
# ==============================================================================

# ------------------------------------------------------------------------------
# SHARED / CORE
# ------------------------------------------------------------------------------
# development | production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT DATABASE DEFAULTS
# ------------------------------------------------------------------------------
# Used by docker-compose to create the local database.
POSTGRES_USER=blrlife
POSTGRES_PASSWORD=blrlife_dev_password
POSTGRES_DB=blrlife
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# PRODUCTION & RUNTIME DATABASE DEFAULTS (FastAPI & Alembic)
# ------------------------------------------------------------------------------
# LOCAL: postgresql+asyncpg://blrlife:blrlife_dev_password@localhost:5432/blrlife
# NEON (Production): postgresql+asyncpg://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql+asyncpg://blrlife:blrlife_dev_password@localhost:5432/blrlife

# ------------------------------------------------------------------------------
# FASTAPI BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS & Security
# LOCAL: ["http://localhost:3000"]
# PRODUCTION: ["https://blr.life", "https://www.blr.life"]
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
FORWARDED_ALLOW_IPS=127.0.0.1

# ------------------------------------------------------------------------------
# NEXT.JS FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# URL where the frontend can reach the API from the browser.
# Must be set during the Vercel build step and at runtime.
# LOCAL: http://localhost:8000
# PRODUCTION: https://api.blr.life
NEXT_PUBLIC_API_URL=http://localhost:8000

# Nominatim OSM Compliance (Required for geocoding)
# PRODUCTION MUST BE A VALID IDENTIFYING STRING, e.g. "blr.life-v1 (contact@your-email.com)"
# LOCAL: "blr.life/1.0-dev (local development)"
NOMINATIM_USER_AGENT="blr.life/1.0-dev (local development)"
