# Application Environment
ENVIRONMENT=development

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL / PostGIS Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blrlife
POSTGRES_USER=blrlife
POSTGRES_PASSWORD=blrlife_dev_password

# Derived / Explicit Database URL (for local running outside docker compose)
DATABASE_URL=postgresql+asyncpg://blrlife:blrlife_dev_password@localhost:5432/blrlife

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
